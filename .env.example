# ─── Base de dades ────────────────────────────────────────────
# Camí relatiu al fitxer SQLite (es crea automàticament si no existeix).
DB_PATH=./data/canconer.db

# ─── NextAuth (Auth.js v5) ────────────────────────────────────
# Genera AUTH_SECRET amb: openssl rand -base64 32  (o `npx auth secret`)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────
# A Google Cloud Console afegir aquest redirect URI:
#   http://localhost:3000/api/auth/callback/google
# (per a producció, substituir el domini)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Analytics ────────────────────────────────────────────────
# Path de la BD d'analytics (opcional; per defecte data/analytics.db)
# ANALYTICS_DB_PATH=
# Path al fitxer GeoLite2-Country.mmdb (opcional; per defecte data/GeoLite2-Country.mmdb)
# ANALYTICS_GEOIP_DB_PATH=
# Llindar de visites per minut a partir del qual una IP es marca com sospitosa
# ANALYTICS_SUSPICIOUS_RPM=120

# ─── Lloc ─────────────────────────────────────────────────────
# URL canònica (sitemap, metadades SEO, QR dels PDF). Si no s'indica,
# es reutilitza AUTH_URL i, en últim terme, https://guitarreo.cat.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Spotify ──────────────────────────────────────────────────
# Només per a la importació massiva (/app/admin/import). Si són buides,
# findSpotify retorna null i la importació continua sense l'enllaç.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Producció (Docker) ───────────────────────────────────────
# En desplegament, Auth.js va darrere d'un reverse proxy i cal:
# AUTH_TRUST_HOST=true
# Vegeu deploy/README.md per al desplegament complet al servidor.
