# ─────────────────────────────────────────────────────────────────
# Variables del desplegament. Copia'l a .env AL SERVIDOR, dins del
# mateix directori que docker-compose.yml, i omple'l.
#
#   cp .env.example .env && chmod 600 .env
#
# Aquest fitxer NO ha d'entrar mai a git amb valors reals.
# ─────────────────────────────────────────────────────────────────

# ─── Imatge ──────────────────────────────────────────────────────
# El teu usuari/organització de GitHub, en MINÚSCULES (GHCR és
# sensible a majúscules i el teu usuari és "twococos").
GHCR_OWNER=twococos

# ─── Base de dades ───────────────────────────────────────────────
# Dins del contenidor. Corresponen al volum ./data del compose.
DB_PATH=/app/data/canconer.db
ANALYTICS_DB_PATH=/app/data/analytics.db
ANALYTICS_GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# ─── NextAuth ────────────────────────────────────────────────────
# Genera'l amb: openssl rand -base64 32
# Si el canvies, totes les sessions obertes cauen.
AUTH_SECRET=

# El domini PÚBLIC, amb https. No localhost: NextAuth hi construeix
# el redirect d'OAuth i Google el compara caràcter a caràcter.
AUTH_URL=https://guitarreo.cat

# Next.js darrere del proxy: sense això Auth.js pot generar URLs http.
AUTH_TRUST_HOST=true

# ─── Google OAuth ────────────────────────────────────────────────
# A Google Cloud Console → Credencials → el teu OAuth client, afegeix
# aquest redirect URI autoritzat:
#   https://guitarreo.cat/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Lloc ────────────────────────────────────────────────────────
# URL canònica (sitemap, metadades SEO, QR dels PDF).
NEXT_PUBLIC_SITE_URL=https://guitarreo.cat

# ─── Analítiques ─────────────────────────────────────────────────
# Visites per minut i IP a partir de les quals es marca com sospitosa.
ANALYTICS_SUSPICIOUS_RPM=120

# ─── Spotify (opcional) ──────────────────────────────────────────
# Només per a la importació massiva (/app/admin/import). Si es deixen
# buides, findSpotify retorna null i la importació continua sense
# l'enllaç de Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
